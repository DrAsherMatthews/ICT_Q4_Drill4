<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Drill 2</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body{
            font-family:'arial', Arial, Helvetica, sans-serif, monospace;
            text-align: center;
            margin-top: 80px;
            background-color: rgb(177, 177, 177);
        }
        .container{
            background-color: rgb(255, 255, 255);
            padding: 50px;
            width: 300px;
            margin:auto;
            border: 3px solid gray;
        }
        input{
            padding:6px;
            width:80%;
            margin-bottom:10px;
        }

        button{
            padding: 8px 15px;
            background-color: rgb(209, 21, 21);
            border: 3px solid rgb(75, 30, 201)
        }

        output{
            margin-top:15px;
            text-align:left;
        }

    </style>
</head>
<body>
    
<div class="container">
    <h1> <b> Heat Index Calculator </b> </h1>
    <br>
    <div>
        <h3> <b> Degree in Celsius </b> </h3>
        <input type="number" id="temperature" placeholder="Input Degree Value">
    </div>

    <div>
        <h3><b> Humidity </b></h3>
        <input type="number" id="humidity" placeholder="Input Percentage Value">
    </div>

<br>
  <button class="btn btn-primary" onclick="calculate()"> CLICK ME </button>


</div>

<script>
    function calculate(){

        let temp = parseFloat(document.getElementById("temperature").value);
        let humidity = parseFloat(document.getElementById("humidity").value);

        let heat = temp + (0.33 * humidity) - 4;
        let status = "";


        switch (true){
            case (heat <= 27):
            alert("Comfortable/Cool")
            break;

            case (heat <= 32):
            alert("Warm")
            break;
            
            case (heat <= 37):
            alert("Hot")
            break;

            case (heat <= 41):
            alert("Very Hot/Caution")
            break;
        
            default:
            alert("Extreme Heat/Danger")
    }
}


</script>

</body>
</html>   